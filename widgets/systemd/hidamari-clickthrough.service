[Unit]
Description=Allow Nemo desktop clicks through the Hidamari wallpaper
After=default.target
ConditionPathExists=%h/.local/lib/berserk-hacker-red-cinnamon/widgets/scripts/hidamari-clickthrough.py

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/lib/berserk-hacker-red-cinnamon/widgets/scripts/hidamari-clickthrough.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
