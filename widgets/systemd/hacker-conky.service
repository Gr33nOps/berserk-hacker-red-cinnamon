[Unit]
Description=Supervised Berserk red Conky monitor
After=graphical-session.target
ConditionPathExists=%h/.local/lib/berserk-hacker-red-cinnamon/widgets/conky-start.sh

[Service]
Type=simple
ExecStart=%h/.local/lib/berserk-hacker-red-cinnamon/widgets/conky-start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
